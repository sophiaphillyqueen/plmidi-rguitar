$strumbx->newstrum('fin1',sub {
  my $this;
  my $lc_stb;
  my $lc_call;
  my $lc_actv; # Active strings bass to treble
  my $lc_vtca; # Active strings treble to bass
  my $lc_opt;
  my $lc_short;
  my $lc_alt; # Flag to do second-half rather than first
  
  $this = shift(@_);
  $lc_opt = $PLUGINS_BAR->extract_hashref(\@_);
  $lc_short = _rfgt($lc_opt,'short');
  $lc_alt = _rfgt($lc_opt,'2hlf');
  
  $lc_stb = $strumbx->ingtr($this);
  $lc_call = [caller(1)];
  
  if ( !($lc_short) ) { $this->add_bar(); }
  
  $lc_actv = $this->tochord(shift(@_),$lc_call);
  $lc_vtca = $this->raudstr();
  
  if ( ! ( $lc_alt && $lc_short ) )
  {
    $lc_stb->sweep($lc_actv->[0],$lc_vtca->[0],$strum_laz,80,$strum_sspw);
  $this->ford(0,2);
    $lc_stb->sweep($lc_vtca->[0],$lc_actv->[0],$strum_laz,80,$strum_sspw);
  $this->ford(0,2);
    $lc_stb->sweep($lc_actv->[0],$lc_vtca->[0],$strum_laz,80,$strum_sspw);
  $this->ford(0,2);
    $lc_stb->sweep($lc_vtca->[0],$lc_actv->[0],$strum_laz,80,$strum_sspw);
  $this->ford(0,2);
    
  }
  
  if ( $lc_short && ( ! ( $lc_alt ) ) ) { return; }
  $lc_stb->sweep($lc_actv->[0],$lc_vtca->[0],$strum_laz,80,$strum_sspw);
  $this->ford(2);
  
  if ( ! ( $lc_short ) ) { $this->add_bar(); }
});


sub _rfgt {
  return $PLUGINS_BAR->ref_get(@_);
}


sub apply {
  my $this;
  my $lc_gt; # The guitar
  my $lc_pf; # The prefix
  my $lc_stb;
  
  # Get the arguments
  $this = shift(@_);
  $lc_gt = shift(@_);
  $lc_pf = shift(@_);
  if ( !(defined($lc_pf)) ) { $lc_pf = ''; }
  
  $lc_stb = $strumbx->ingtr($lc_gt);
  $lc_stb->insert($lc_pf);
}



1;
