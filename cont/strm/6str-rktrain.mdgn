use strict;

my $strum_laz = 8;
my $strum_spw = .9;
my $strum_sspw = .95;

our $PLUGINS_BAR;
our $PLUGIN_DIRNAME;

my $respack = $PLUGINS_BAR->find_this_bundle($PLUGIN_DIRNAME);

my $strumbx = $PLUGINS_BAR->fsplug([($respack . '/tll/strumhand.mdgn'),'StrumHand']);

$strumbx->newstrum('ss',sub {
  my $this;
  my $lc_stb;
  my $lc_call;
  my $lc_actv; # Active strings bass to treble
  my $lc_vtca; # Active strings treble to bass
  my $lc_opt;
  my $lc_short;
  
  $this = shift(@_);
  $lc_opt = $PLUGINS_BAR->extract_hashref(\@_);
  $lc_short = _rfgt($lc_opt,'short');
  
  $lc_stb = $strumbx->ingtr($this);
  $lc_call = [caller(1)];
  
  if ( !($lc_short) ) { $this->add_bar(); }
  
  $lc_actv = $this->tochord(shift(@_),$lc_call);
  $lc_vtca = $this->raudstr();
  $lc_stb->sweep($lc_actv->[0],$lc_actv->[1],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_actv->[1],$lc_actv->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_actv->[0],$lc_vtca->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_vtca->[0],$lc_actv->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  
  if ( $lc_short ) { return; }
  
  $lc_actv = $this->tochord(shift(@_),$lc_call);
  $lc_vtca = $this->raudstr();
  $lc_stb->sweep($lc_actv->[0],$lc_actv->[1],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_actv->[1],$lc_actv->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_actv->[0],$lc_vtca->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  $lc_stb->sweep($lc_vtca->[0],$lc_actv->[0],$strum_laz,80,$strum_spw);
  $this->ford(0,2);
  
  $this->add_bar();
});

