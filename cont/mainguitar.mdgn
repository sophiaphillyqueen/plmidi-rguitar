use Storable qw(dclone);
use File::Path qw(make_path);
use Fcntl qw(O_WRONLY O_CREAT O_EXCL);
use Errno qw(EEXIST);
use POSIX qw(strftime);
use Scalar::Util qw(reftype blessed);
use strict;

sub new {
  my $this;
  my $lc_bart;
  my $lc_rawneck; # Raw version of neck provided to this
  my $lc_ret; # Return object
  my $lc_neck; # On-board diagram of the guitar neck
  my $lc_tune; # Will go as arg to construct low level
  my $lc_llev;
  
  # Get stuff from the arguments
  $this = shift(@_);
  $lc_bart = shift(@_);
  $lc_rawneck = shift(@_);
  
  # Initialize pre-blessed object
  $lc_ret = {
    'bart' => $lc_bart,
  };
  
  # Set up the neck diagram, as well as the tuning
  # prototype that will go to the low-level implementation
  # engine's constructor
  $lc_neck = [ 0 ]; # To deal with offset of array element
  $lc_tune = [ ];
  {
    my $lc2_a; # Tracks elements of raw version of neck
    my $lc2_b; # Numerical pitch representation of $lc2_a
    foreach $lc2_a (@$lc_rawneck)
    {
      $lc2_b = $lc_bart->note_to_pitch($lc2_a);
      push @$lc_tune, $lc2_b;
      push @$lc_neck, {
        'bas' => $lc2_b, # Base pitch of string
        'fret' => 0, # The fret that the finger (if any) covers
        'fngr' => '', # The fingering
        'aud' => 1, # Is this string audible (non-muted)?
      };
    }
  }
  $lc_ret->{'neck'} = $lc_neck;
  $lc_ret->{'nsiz'} = ( scalar @$lc_rawneck );
  $lc_ret->{'bar'} = 0; # Where this measure begins
  $lc_ret->{'pos'} = [0,0,0,0]; # Position within measure
  $lc_ret->{'riff'} = {}; # Hash of all riffs
  $lc_ret->{'chord'} = {}; # Chord catalog
  
  # Constructing the low-level implementation object is
  # crucial --- and if it fails, then the construction
  # of _this_ object should _also_ fail.
  $lc_llev = $lc_bart->fromus('Impl::MIDI1_MultiChan',$lc_tune,{
    'tpb' => 960,
  });
  if ( !($lc_llev) )
  {
    print STDERR "\nFailed to invoke low-level engine.\n\n";
    return undef;
  }
  $lc_ret->{'llev'} = $lc_llev;
  
  # Bless and return the new object.
  return bless ( $lc_ret, ( ref($this) || $this ) );
}

sub fret {
  my $this;
  my $lc_string; # Target string
  my $lc_fret; # New fret
  my $lc_fngr; # New finger
  my $lc_inob; # String structure in this object
  my $lc_pitch; # New pitch
  $this = shift(@_);
  $lc_string = shift(@_);
  $lc_fret = shift(@_);
  $lc_fngr = shift(@_);
  
  # Sooner die than re-fret a non-existent string.
  if ( $lc_string < 0.5 ) { die "\nOut of bounds.\n"; }
  if ( $lc_string > ( ( $this->{'nsiz'} ) + 0.5 ) ) { die "\nOut of bounds.\n"; }
  
  # Simplify reference to string's data
  $lc_inob = $this->{'neck'}->[$lc_string];
  
  # Send note-off if necessary:
  if ( $lc_fret != $lc_inob->{'fret'} ) { $this->{'llev'}->note_off($lc_string); }
  if ( $lc_fngr ne $lc_inob->{'fngr'} ) { $this->{'llev'}->note_off($lc_string); }
  
  # Set new values:
  $lc_inob->{'fret'} = $lc_fret;
  $lc_inob->{'fngr'} = $lc_fngr;
  $lc_inob->{'aud'} = 1;
  
  # Calculate target pitch
  $lc_pitch = ($lc_inob->{'bas'} + $lc_fret);
  
  # Set to target pitch -- and return
  return $this->{'llev'}->set_pitch($lc_string,$lc_pitch);
}

sub ford {
  my $this;
  my $lc_at;
  $this = shift(@_);
  
  $lc_at = shift(@_);
  if ( defined $lc_at )
  {
    $this->{'pos'}->[0] = int($this->{'pos'}->[0] + $lc_at + 0.2);
  }
  
  $lc_at = shift(@_);
  if ( defined $lc_at )
  {
    $this->{'pos'}->[1] = int($this->{'pos'}->[1] + $lc_at + 0.2);
  }
  
  $lc_at = shift(@_);
  if ( defined $lc_at )
  {
    $this->{'pos'}->[2] = int($this->{'pos'}->[2] + $lc_at + 0.2);
  }
  
  $lc_at = shift(@_);
  if ( defined $lc_at )
  {
    $this->{'pos'}->[3] = int($this->{'pos'}->[3] + $lc_at + 0.2);
  }
  
  while ( $this->{'pos'}->[3] > 3.5 )
  {
    $this->{'pos'}->[3] = int($this->{'pos'}->[3] - 3.8);
    $this->{'pos'}->[2] = int($this->{'pos'}->[2] + 1.2);
  }
  
  while ( $this->{'pos'}->[2] > 3.5 )
  {
    $this->{'pos'}->[2] = int($this->{'pos'}->[2] - 3.8);
    $this->{'pos'}->[1] = int($this->{'pos'}->[1] + 1.2);
  }
  
  while ( $this->{'pos'}->[1] > 3.5 )
  {
    $this->{'pos'}->[1] = int($this->{'pos'}->[1] - 3.8);
    $this->{'pos'}->[0] = int($this->{'pos'}->[0] + 1.2);
  }
  
  $this->to_trace();
  
  return dclone($this->{'pos'});
}


sub add_bar {
  my $this;
  my $lc_fford;
  my $lc_idl;
  $this = shift(@_);
  $lc_fford = 0;
  $lc_fford += ( $this->{'pos'}->[3] * 15 );
  $lc_fford += ( $this->{'pos'}->[2] * 60 );
  $lc_fford += ( $this->{'pos'}->[1] * 240 );
  $lc_fford += ( $this->{'pos'}->[0] * 960 );
  $lc_fford = int($lc_fford + 0.2);
  $lc_idl = int($this->{'bar'} + $lc_fford + 0.2);
  $this->{'bar'} = $lc_idl;
  $this->{'pos'} = [0,0,0,0];
  return $this->to_trace();
}


sub to_trace {
  my $this;
  my $lc_idl; # Where ticker should be
  my $lc_at;  # Where ticker is
  my $lc_must; # How far ticker must advance
  $this = shift(@_);
  $lc_idl = $this->{'bar'};
  $lc_idl += ( $this->{'pos'}->[3] * 15 );
  $lc_idl += ( $this->{'pos'}->[2] * 60 );
  $lc_idl += ( $this->{'pos'}->[1] * 240 );
  $lc_idl += ( $this->{'pos'}->[0] * 960 );
  $lc_idl = int($lc_idl + 0.2);
  $lc_at = $this->{'llev'}->ticks_forward();
  if ( $lc_at > ( $lc_idl - 0.5 ) ) { return $lc_at; }
  $lc_must = int(($lc_idl - $lc_at) + 0.2);
  return $this->{'llev'}->ticks_forward($lc_must);
}

sub ticks_forward {
  my $this;
  $this = shift(@_);
  return $this->{'llev'}->ticks_forward(@_);
}


sub play {
  # Strum/Pluck a String
  
  my $this;
  my $lc_string; # What string we will play
  my $lc_ext; # Extra stuff on the plucking
  my $lc_rawret; # Return from low-level pluck
  
  # Get the stuff from arguments.
  $this = shift(@_);
  $lc_string = shift(@_);
  $lc_ext = shift(@_);
  
  # Sooner die than pluck a non-existent string.
  if ( $lc_string < 0.5 ) { die "\nOut of bounds.\n"; }
  if ( $lc_string > ( ( $this->{'nsiz'} ) + 0.5 ) ) { die "\nOut of bounds.\n"; }
  
  # No sound if the string is muted.
  if ( !($this->{'neck'}->[$lc_string]->{'aud'}) )
  {
    return
    {
      'aud' => 0,
      'bas' => $this->{'neck'}->[$lc_string]->{'bas'},
      'fret' => $this->{'neck'}->[$lc_string]->{'fret'},
    };
  }
  
  $lc_rawret = $this->{'llev'}->note_on($lc_string,$lc_ext);
  
  $lc_rawret->{'bas'} = $this->{'neck'}->[$lc_string]->{'bas'};
  $lc_rawret->{'fret'} = $this->{'neck'}->[$lc_string]->{'fret'};
  
  return $lc_rawret;
}

sub outto {
  # Generate a timestamp and delegate the actual
  # output operation to the internal method.
  #
  # The default filename prefix is 'out'.

  my $this;
  my $lc_dir; # Destination directory
  my $lc_prefix; # Output filename prefix
  my $lc_stamp; # Generated timestamp

  $this = shift(@_);
  $lc_dir = shift(@_);
  $lc_prefix = shift(@_);

  if ( !defined($lc_prefix) ) { $lc_prefix = 'out'; }

  $lc_stamp = _output_timestamp();
  return $this->_outto($lc_dir,$lc_prefix,$lc_stamp);
}

sub doriff {
  # This method plays a riff. The first argument is
  # the name of a riff registered to this object.
  # All further arguments get forwarded to the riff
  # function after the reference to this object itself.
  #
  # This function returns a hashref. In the event
  # of failure, that hashref's `ok` field is either
  # absent or present with a value of `0`. In the
  # event of success, the hashref's `ok` field is
  # present with a value of `1`, and the `ret` field
  # contains the return-value of the riff function.
  my $this;
  my $lc_nom;
  my $lc_code;
  my $lc_ret;
  
  # Get stuff from the arguments.
  $this = shift(@_);
  $lc_nom = shift(@_);
  
  # Obtain and validate the code.
  if ( !defined($lc_nom) ) { return { }; }
  if ( ( reftype($lc_nom) // '' ) ne '' ) { return { }; }
  if ( $lc_nom eq '' ) { return { }; }
  $lc_code = $this->{'riff'}->{$lc_nom};
  if ( ( reftype($lc_code) // '' ) ne 'CODE' ) { return { }; }
  
  # Play the riff and go home.
  $lc_ret = &$lc_code($this,@_);
  return { 'ok' => 1, 'ret' => $lc_ret, };
}

sub setriff {
  # Adds a riff to the object from an already-present
  # possibly-anonymous function.
  #
  # First argument specifies the name of the riff, and
  # the second argument is the coderef.
  #
  # The return value is a hashref in which the field `ok`
  # has a value of `1` for success, and is either absent
  # or with a value of `0` for failure.
  my $this;
  my $lc_name;
  my $lc_code;
  
  # Get stuff from the arguments:
  $this = shift(@_);
  $lc_name = shift(@_);
  $lc_code = shift(@_);
  
  # Make sure we got valid stuff.
  if ( !(defined($lc_name)) ) { return { }; }
  if ( reftype($lc_name) ) { return { }; }
  if ( $lc_name eq '' ) { return { }; }
  if ( ( reftype($lc_code) // '' ) ne 'CODE' ) { return { }; }
  
  # Now we register the riff and go home.
  $this->{'riff'}->{$lc_name} = $lc_code;
  return { 'ok' => 1, };
}

sub doriff {
  # Plays a riff based on the name.
  my $this;
  my $lc_nom;
  my $lc_code;
  my $lc_ret;
  
  # First we get the argumentary
  $this = shift(@_);
  $lc_nom = shift(@_);
  
  # Let us validate the name.
  if ( !defined($lc_nom) ) { return { }; }
  if ( reftype($lc_nom) ) { return { }; }
  if ( $lc_nom eq '' ) { return { }; }
  
  # Now we validate the riff function
  $lc_code = $this->{'riff'}->{$lc_nom};
  if ( ( reftype($lc_code) // '' ) ne 'CODE' ) { return { }; }
  
  # And if we are still here, we play the riff and go home.
  $lc_ret = &$lc_code($this,@_);
  return { 'ok' => 1, 'ret' => $lc_ret, };
}

sub enterchord {
  # This method enters a chord into the object's
  # chord catalog.
  my $this;
  my $lc_rchord;
  my $lc_call;
  my $lc_cneck;
  my $lc_names;
  my $lc_each;
  
  # First, we get the argumentary
  $this = shift(@_);
  $lc_rchord = shift(@_);
  $lc_call = shift(@_);
  if ( !defined($lc_call) ) { $lc_call = [caller(0)]; }
  
  # Then we validate the chord.
  if ( !($this->_valid_chord($lc_rchord,$lc_call)) )
  {
    return 0;
  }
  
  # And we scrub the chord.
  $lc_cneck = _scrub_chord($lc_rchord->{'neck'});
  $lc_names = $lc_rchord->{'nomx'};
  
  # And we add the chord.
  foreach $lc_each (@$lc_names)
  {
    $this->{'chord'}->{$lc_each} = $lc_cneck;
  }
  
  # If we got this far, it was a success.
  return 1;
}

sub load_chords {
  # Loads a JSON chord catalog into this instrument.
  # First argument: filename; second: optional options hashref.
  #
  # On success, returns a hashref with 'ok' => 1,
  # and counts of loaded and rejected chord entries.
  # On failure to load the file, returns { 'ok' => 0 }.

  my $this;
  my $lc_filename;
  my $lc_options;
  my $lc_call;
  my $lc_raw;
  my $lc_chord;
  my $lc_loaded;
  my $lc_rejected;
  my $lc_index;

  $this = shift(@_);
  $lc_filename = shift(@_);
  $lc_call = [caller(0)];

  # Invalid options are survivable, but merit a warning.
  if ( @_ )
  {
    $lc_options = shift(@_);
    if ( ( reftype($lc_options) // '' ) ne 'HASH' )
    {
      warn "load_chords (called from $lc_call->[1] line $lc_call->[2]): invalid options hash; using empty options.\n";
      $lc_options = {};
    }
  } else {
    $lc_options = {};
  }

  # The filename must be a nonempty scalar.
  if ( !defined($lc_filename) || reftype($lc_filename) || $lc_filename eq '' )
  {
    warn "load_chords (called from $lc_call->[1] line $lc_call->[2]): invalid filename.\n";
    return { 'ok' => 0, };
  }

  # Load and check the basic JSON catalog structure.
  $lc_raw = _load_crd_json($lc_filename,$lc_call);
  if ( !($lc_raw->{'ok'}) ) { return { 'ok' => 0, }; }

  # Register each chord entry independently.
  $lc_loaded = 0;
  $lc_rejected = 0;
  $lc_index = 0;

  foreach $lc_chord (@{$lc_raw->{'val'}->{'crdx'}})
  {
    $lc_index = int($lc_index + 1.2);

    if ( $this->enterchord($lc_chord,$lc_call) )
    {
      $lc_loaded = int($lc_loaded + 1.2);
    } else {
      warn "Chord catalog '$lc_filename': entry $lc_index rejected.\n";
      $lc_rejected = int($lc_rejected + 1.2);
    }
  }

  return {
    'ok' => 1,
    'loaded' => $lc_loaded,
    'rejected' => $lc_rejected,
  };
}



# ############### #
# ##  HELPERS  ## #
# ############### #

sub _scrub_chord {
  # Accepts a validated `neck` arrayref.
  # Returns a new arrayref containing only the
  # `fret`, `fngr`, and `aud` fields of each string.
  # Does not modify the original.

  my $lc_neck;
  my $lc_ret;
  my $lc_each;

  $lc_neck = shift(@_);
  $lc_ret = [];

  foreach $lc_each (@$lc_neck)
  {
    push(@$lc_ret,{
      'fret' => $lc_each->{'fret'},
      'fngr' => $lc_each->{'fngr'},
      'aud' => $lc_each->{'aud'},
    });
  }

  return $lc_ret;
}

sub _valid_chord {
  # Validates one chord catalog entry for this guitar.
  # First argument: the proposed chord entry.
  # Second argument: arrayref containing caller() information.
  #
  # Returns 1 if valid, 0 otherwise.
  # Does not modify the entry.

  my $this;
  my $lc_entry;
  my $lc_caller;
  my $lc_where;
  my $lc_field;
  my $lc_name;
  my $lc_string;
  my $lc_index;

  $this = shift(@_);
  $lc_entry = shift(@_);
  $lc_caller = shift(@_);

  $lc_where = "Chord validation (called from "
    . $lc_caller->[1] . " line " . $lc_caller->[2] . "): ";

  # Check the basic structure of the chord entry.
  if ( ( reftype($lc_entry) // '' ) ne 'HASH' )
  {
    warn "${lc_where}entry must be a hash.\n";
    return 0;
  }

  foreach $lc_field ('nomx','neck')
  {
    if ( ( reftype($lc_entry->{$lc_field}) // '' ) ne 'ARRAY' )
    {
      warn "${lc_where}'$lc_field' must be an array.\n";
      return 0;
    }
  }

  # There must be at least one valid chord name.
  if ( !@{$lc_entry->{'nomx'}} )
  {
    warn "${lc_where}'nomx' must contain at least one name.\n";
    return 0;
  }

  foreach $lc_name (@{$lc_entry->{'nomx'}})
  {
    if ( !defined($lc_name) || reftype($lc_name) || $lc_name eq '' || $lc_name eq '-' )
    {
      warn "${lc_where}invalid chord name in 'nomx'.\n";
      return 0;
    }
  }

  # The number of strings must match this guitar.
  if ( @{$lc_entry->{'neck'}} != $this->{'nsiz'} )
  {
    warn "${lc_where}'neck' must contain $this->{'nsiz'} strings.\n";
    return 0;
  }

  # Validate each string's required fields.
  $lc_index = 0;
  foreach $lc_string (@{$lc_entry->{'neck'}})
  {
    $lc_index = int($lc_index + 1.2);

    if ( ( reftype($lc_string) // '' ) ne 'HASH' )
    {
      warn "${lc_where}string $lc_index must be a hash.\n";
      return 0;
    }

    foreach $lc_field ('fret','fngr','aud')
    {
      if ( !exists($lc_string->{$lc_field}) )
      {
        warn "${lc_where}string $lc_index missing '$lc_field'.\n";
        return 0;
      }
    }

    # Fret must be a nonnegative integer.
    if ( !defined($lc_string->{'fret'}) || reftype($lc_string->{'fret'}) || $lc_string->{'fret'} !~ /\A[0-9]+\z/ )
    {
      warn "${lc_where}string $lc_index: invalid 'fret'.\n";
      return 0;
    }

    # Fingering must be nonempty, printable Unicode,
    # without leading or trailing spaces.
    if ( !defined($lc_string->{'fngr'}) || reftype($lc_string->{'fngr'}) ||
         $lc_string->{'fngr'} !~ /\A[[:print:]]+\z/u ||
         $lc_string->{'fngr'} =~ /\A | \z/ )
    {
      warn "${lc_where}string $lc_index: invalid 'fngr'.\n";
      return 0;
    }

    # Audibility must be either 0 or 1.
    if ( !defined($lc_string->{'aud'}) || reftype($lc_string->{'aud'}) ||
         ( $lc_string->{'aud'} ne '0' && $lc_string->{'aud'} ne '1' ) )
    {
      warn "${lc_where}string $lc_index: invalid 'aud'.\n";
      return 0;
    }
  }

  return 1;
}

sub _load_crd_json {
  # Does the same as `_load_json()` --- except it will
  # declare it a failure if the file does not have the
  # basic structure of a chord catalog.
  
  my $lc_ret;
  
  # If `_load_json()` fails, not much to do.
  $lc_ret = _load_json(@_);
  if ( !($lc_ret->{'ok'}) ) { return $lc_ret; }
  $lc_ret->{'loaded_json'} = 1;
  
  # The loaded file needs to be a hash.
  if ( ( reftype($lc_ret->{'val'}) // '' ) ne 'HASH' )
  {
    $lc_ret->{'ok'} = 0;
    warn "Chord catalog '$_[0]' (called from " . $_[1]->[1] . " line " . $_[1]->[2] . "): top-level JSON value must be a hash.\n";
    return $lc_ret;
  }
  
  # The loaded file needs to have a hash titled 'meta'
  if ( ( reftype($lc_ret->{'val'}->{'meta'}) // '' ) ne 'HASH' )
  {
    $lc_ret->{'ok'} = 0;
    warn "Chord catalog '$_[0]' (called from " . $_[1]->[1] . " line " . $_[1]->[2] . "): top-level JSON hash must contain hash within called 'meta'.\n";
    return $lc_ret;
  }
  
  # The loaded file needs to have an array titled 'crdx'
  if ( ( reftype($lc_ret->{'val'}->{'crdx'}) // '' ) ne 'ARRAY' )
  {
    $lc_ret->{'ok'} = 0;
    warn "Chord catalog '$_[0]' (called from " . $_[1]->[1] . " line " . $_[1]->[2] . "): top-level JSON hash must contain array called 'crdx'.\n";
    return $lc_ret;
  }
  
  # If we passed --- THEN GREAT!!!!
  return $lc_ret;
}

sub _load_json {
  # First argument: filename of a JSON file.
  # Second argument: arrayref containing caller() information.
  #
  # Returns { 'ok' => 1, 'val' => ... } on success.
  # On any failure, issues a warning and returns {}.

  my $lc_filename;
  my $lc_caller;
  my $lc_value;
  my $lc_error;

  $lc_filename = shift(@_);
  $lc_caller = shift(@_);

  # Read and decode the file, catching all failures.
  $lc_value = eval {
    my $lc2_fh;
    my $lc2_raw;

    open($lc2_fh,'<:raw',$lc_filename)
      or die "Cannot open file: $!\n";

    local $/;
    $lc2_raw = <$lc2_fh>;
    if ( !defined($lc2_raw) ) { die "Cannot read file: $!\n"; }

    close($lc2_fh) or die "Cannot close file: $!\n";

    JSON::PP->new->utf8->decode($lc2_raw);
  };

  # Report any error without terminating the program.
  $lc_error = $@;
  if ( $lc_error ne '' )
  {
    chomp($lc_error);
    warn "JSON file '$lc_filename' (called from $lc_caller->[1] line $lc_caller->[2]): $lc_error\n";
    return { };
  }

  # Return the successfully decoded JSON.
  return { 'ok' => 1, 'val' => $lc_value, };
}

sub _outto {
  # Finalize MIDI output and save it in the requested
  # directory, creating the directory if necessary.
  #
  # The caller supplies the filename prefix and timestamp.
  # Return the complete filename of the output.

  my $this;
  my $lc_dir; # Destination directory
  my $lc_prefix; # Output filename prefix
  my $lc_stamp; # Supplied timestamp
  my $lc_ext; # Required filename extension
  my $lc_path; # Full output filename
  my $lc_fh; # Output filehandle
  my $lc_midi; # Finalized MIDI data

  $this = shift(@_);
  $lc_dir = shift(@_);
  $lc_prefix = shift(@_);
  $lc_stamp = shift(@_);

  # Require a destination directory.
  if ( !defined($lc_dir) || $lc_dir eq '' )
  {
    die "\nNo output directory specified.\n";
  }

  # Create directory and reserve filename.
  make_path($lc_dir);
  $lc_ext = $this->{'llev'}->capabilities()->{'extension'};
  ($lc_path,$lc_fh) = _reserve_output_file(
    $lc_dir,$lc_ext,$lc_prefix,$lc_stamp
  );

  # Finalize the MIDI and save it as binary data.
  binmode($lc_fh) or die "\nCannot enable binary mode: $!\n";
  $lc_midi = $this->{'llev'}->end();
  print {$lc_fh} $lc_midi or die "\nCannot write $lc_path: $!\n";
  close($lc_fh) or die "\nCannot close $lc_path: $!\n";

  return $lc_path;
}

sub _output_timestamp {
  # Generate a timestamp for output filenames.
  return strftime('%Y-%m%d-%H%M%S',localtime());
}

sub _reserve_output_file {
  # Reserve an unused timestamped filename in the
  # specified directory, using the specified extension,
  # prefix, and timestamp.
  #
  # Return both the full filename and its open filehandle.

  my $lc_dir; # Destination directory
  my $lc_ext; # Required filename extension
  my $lc_prefix; # Output filename prefix
  my $lc_stamp; # Supplied timestamp
  my $lc_root; # Filename prefix with timestamp
  my $lc_path; # Full candidate filename
  my $lc_number; # Collision suffix number
  my $lc_ready; # Whether reservation succeeded
  my $lc_fh; # Reserved filehandle

  $lc_dir = shift(@_);
  $lc_ext = shift(@_);
  $lc_prefix = shift(@_);
  $lc_stamp = shift(@_);

  # Establish the original filename.
  $lc_root = "$lc_prefix-$lc_stamp";
  $lc_number = 1;
  $lc_ready = 0;

  # Keep trying candidate filenames until one
  # has been successfully reserved.
  while ( !($lc_ready) )
  {
    # The first candidate has no numeric suffix.
    if ( $lc_number == 1 )
    {
      $lc_path = "$lc_dir/$lc_root.$lc_ext";
    } else {
      $lc_path = "$lc_dir/$lc_root-$lc_number.$lc_ext";
    }

    # Reserve this filename without permitting overwrite.
    $lc_ready = sysopen($lc_fh,$lc_path,O_WRONLY | O_CREAT | O_EXCL);

    if ( !($lc_ready) )
    {
      # An existing filename warrants another attempt.
      # Any other failure is fatal.
      if ( $! != EEXIST ) { die "\nCannot create $lc_path: $!\n"; }

      $lc_number = int($lc_number + 1.2);
    }
  }

  return ($lc_path,$lc_fh);
}


1;
